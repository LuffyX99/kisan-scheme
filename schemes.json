  {
    "id": "pm_kusum",
    "name": {
      "hi": "पीएम-कुसुम",
      "hinglish": "PM-KUSUM solar pumps",
      "kn": "ಪಿಎಂ-ಕುಸುಮ್",
      "ta": "பி.எம்-குசும்",
      "te": "పీఎం-కుసుమ్",
      "mr": "पीएम-कुसुम"
    },
    "benefit": {
      "hi": "योजना के घटक और राज्य के खुले आवेदन के अनुसार सौर पंप सहायता।",
      "hinglish": "Solar pump support; component aur state application window check karein.",
      "kn": "ಘಟಕ ಮತ್ತು ರಾಜ್ಯದ ಅರ್ಜಿ ಅವಧಿಯಂತೆ ಸೌರ ಪಂಪ್ ನೆರವು.",
      "ta": "கூறு மற்றும் மாநில விண்ணப்ப காலத்தைப் பொறுத்த சூரிய பம்ப் உதவி.",
      "te": "భాగం, రాష్ట్ర దరఖాస్తు గడువును బట్టి సోలార్ పంపు సహాయం.",
      "mr": "घटक आणि राज्य अर्ज कालावधीनुसार सौर पंप मदत."
    },
    "eligibility": {
      "needs_state_program_check": true
    },
    "documents": [
      "Aadhaar",
      "Land record",
      "Bank details",
      "Pump and electricity details"
    ],
    "where_to_apply": "State renewable energy agency portal",
    "source_url": "https://pmkusum.mnre.gov.in/",
    "last_verified_date": null
  },
  {
    "id": "pmksy",
    "name": {
      "hi": "प्रधानमंत्री कृषि सिंचाई योजना",
      "hinglish": "PM Krishi Sinchayee Yojana",
      "kn": "ಪ್ರಧಾನಮಂತ್ರಿ ಕೃಷಿ ಸಿಂಚಾಯಿ ಯೋಜನೆ",
      "ta": "பிரதம மந்திரி கிருஷி சிஞ்சாயி திட்டம்",
      "te": "ప్రధానమంత్రి కృషి సించాయీ యోజన",
      "mr": "प्रधानमंत्री कृषी सिंचन योजना"
    },
    "benefit": {
      "hi": "सिंचाई और सूक्ष्म सिंचाई सहायता राज्य की उपलब्ध योजना के अनुसार।",
      "hinglish": "Irrigation/drip support, state ke active component ke hisaab se.",
      "kn": "ರಾಜ್ಯದ ಲಭ್ಯ ಘಟಕದಂತೆ ನೀರಾವರಿ ಮತ್ತು ಹನಿ ನೀರಾವರಿ ನೆರವು.",
      "ta": "மாநிலத்தின் நடைமுறைத் திட்டத்தின்படி பாசன உதவி.",
      "te": "రాష్ట్రంలో అమల్లో ఉన్న భాగాన్ని బట్టి నీటిపారుదల సహాయం.",
      "mr": "राज्यातील उपलब्ध घटकानुसार सिंचन मदत."
    },
    "eligibility": {
      "needs_state_program_check": true
    },
    "documents": [
      "Land record",
      "Aadhaar",
      "Bank details",
      "Water source details"
    ],
    "where_to_apply": "State agriculture or horticulture department",
    "source_url": "https://pmksy.gov.in/",
    "last_verified_date": null
  },
  {
    "id": "karnataka_raitha_siri",
    "name": {
      "hi": "रायता सिरी (कर्नाटक)",
      "hinglish": "Raitha Siri (Karnataka)",
      "kn": "ರೈತ ಸಿರಿ",
      "ta": "ரைதா சிரி",
      "te": "రైత సిరి",
      "mr": "रायता सिरी"
    },
    "benefit": {
      "hi": "मोटे अनाज उगाने वाले किसानों के लिए राज्य सहायता; चालू स्थिति जांचें।",
      "hinglish": "Millet growers ke liye Karnataka support; current status verify karein.",
      "kn": "ಸಿರಿಧಾನ್ಯ ಬೆಳೆಗಾರರಿಗೆ ರಾಜ್ಯ ನೆರವು; ಈಗಿನ ಸ್ಥಿತಿ ಪರಿಶೀಲಿಸಿ.",
      "ta": "சிறுதானிய விவசாயிகளுக்கான மாநில உதவி; தற்போதைய நிலையைச் சரிபார்க்கவும்.",
      "te": "చిరుధాన్య రైతులకు రాష్ట్ర సహాయం; ప్రస్తుత స్థితి నిర్ధారించండి.",
      "mr": "भरडधान्य उत्पादकांसाठी राज्य मदत; सध्याची स्थिती तपासा."
    },
    "eligibility": {
      "states": [
        "Karnataka"
      ],
      "crops": [
        "millet",
        "sorghum"
      ]
    },
    "documents": [
      "Aadhaar",
      "Land record",
      "Bank details"
    ],
    "where_to_apply": "Karnataka agriculture department or Raitha Samparka Kendra",
    "source_url": "https://raitamitra.karnataka.gov.in/",
    "last_verified_date": null
  },
  {
