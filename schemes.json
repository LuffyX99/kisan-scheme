[
  {
    "id": "pm_kisan",
    "name": {
      "hi": "पीएम-किसान",
      "hinglish": "PM-KISAN",
      "kn": "ಪಿಎಂ-ಕಿಸಾನ್",
      "ta": "பி.எம்-கிசான்",
      "te": "పీఎం-కిసాన్",
      "mr": "पीएम-किसान"
    },
    "benefit": {
      "hi": "पात्र किसान परिवार को सालाना छह हजार रुपये, तीन किस्तों में।",
      "hinglish": "Eligible farmer families ko saal ke chhah hazaar rupaye, teen kishton mein.",
      "kn": "ಅರ್ಹ ರೈತ ಕುಟುಂಬಕ್ಕೆ ವರ್ಷಕ್ಕೆ ಆರು ಸಾವಿರ ರೂಪಾಯಿ, ಮೂರು ಕಂತುಗಳಲ್ಲಿ.",
      "ta": "தகுதியுள்ள விவசாய குடும்பத்திற்கு ஆண்டுக்கு ஆறாயிரம் ரூபாய், மூன்று தவணைகளில்.",
      "te": "అర్హ రైతు కుటుంబానికి ఏడాదికి ఆరు వేల రూపాయలు, మూడు విడతల్లో.",
      "mr": "पात्र शेतकरी कुटुंबाला वर्षाला सहा हजार रुपये, तीन हप्त्यांत."
    },
    "eligibility": {
      "ownership_required": true,
      "allowed_ownership": [
        "owner"
      ],
      "requires_true": [
        "has_bank_account"
      ]
    },
    "documents": [
      "Aadhaar",
      "Land record",
      "Bank passbook"
    ],
    "where_to_apply": "PM-KISAN portal, CSC, or local agriculture office",
    "source_url": "https://pmkisan.gov.in/",
    "last_verified_date": null
  },
  {
    "id": "pmfby",
    "name": {
      "hi": "प्रधानमंत्री फसल बीमा योजना",
      "hinglish": "PMFBY crop insurance",
      "kn": "ಪ್ರಧಾನಮಂತ್ರಿ ಫಸಲ್ ಬಿಮಾ ಯೋಜನೆ",
      "ta": "பிரதமர் பயிர் காப்பீட்டுத் திட்டம்",
      "te": "ప్రధానమంత్రి ఫసల్ బీమా యోజన",
      "mr": "प्रधानमंत्री पीक विमा योजना"
    },
    "benefit": {
      "hi": "अधिसूचित फसल और मौसम के लिए फसल बीमा।",
      "hinglish": "Notified crop aur season ke liye fasal insurance.",
      "kn": "ಅಧಿಸೂಚಿತ ಬೆಳೆ ಮತ್ತು ಋತುವಿಗೆ ಬೆಳೆ ವಿಮೆ.",
      "ta": "அறிவிக்கப்பட்ட பயிர் மற்றும் பருவத்திற்கான காப்பீடு.",
      "te": "ప్రకటించిన పంట, సీజన్‌కు పంట బీమా.",
      "mr": "अधिसूचित पीक आणि हंगामासाठी पीक विमा."
    },
    "eligibility": {
      "tenant_review": true,
      "crop_season_required": true
    },
    "documents": [
      "Aadhaar",
      "Land record or cultivation proof",
      "Bank details",
      "Sowing declaration"
    ],
    "where_to_apply": "Bank, CSC, insurer, or state agriculture portal; check current enrollment window",
    "source_url": "https://pmfby.gov.in/",
    "last_verified_date": null
  },
  {
    "id": "kcc",
    "name": {
      "hi": "किसान क्रेडिट कार्ड",
      "hinglish": "Kisan Credit Card (KCC)",
      "kn": "ಕಿಸಾನ್ ಕ್ರೆಡಿಟ್ ಕಾರ್ಡ್",
      "ta": "கிசான் கடன் அட்டை",
      "te": "కిసాన్ క్రెడిట్ కార్డ్",
      "mr": "किसान क्रेडिट कार्ड"
    },
    "benefit": {
      "hi": "खेती और संबद्ध जरूरतों के लिए बैंक से किसान ऋण सुविधा।",
      "hinglish": "Kheti aur judi zarooraton ke liye bank credit facility.",
      "kn": "ಕೃಷಿ ಮತ್ತು ಸಂಬಂಧಿತ ಅಗತ್ಯಗಳಿಗೆ ಬ್ಯಾಂಕ್ ಸಾಲ ಸೌಲಭ್ಯ.",
      "ta": "விவசாயம் மற்றும் தொடர்புடைய தேவைகளுக்கு வங்கி கடன்.",
      "te": "వ్యవసాయం, అనుబంధ అవసరాలకు బ్యాంకు రుణ సౌకర్యం.",
      "mr": "शेती व संबंधित गरजांसाठी बँक कर्ज सुविधा."
    },
    "eligibility": {
      "requires_true": [
        "has_bank_account"
      ]
    },
    "documents": [
      "Identity and address proof",
      "Land or cultivation records",
      "Bank application documents"
    ],
    "where_to_apply": "Participating bank branch",
    "source_url": "https://www.myscheme.gov.in/schemes/kcc",
    "last_verified_date": null
  },
